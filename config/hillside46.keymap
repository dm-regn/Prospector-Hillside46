        };

        stno_ky: stno_ky {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K &kp Y>;
            label = "STNO_KY";
        };

        stno_vy: stno_vy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V &kp Y>;
