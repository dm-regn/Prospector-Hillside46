            label = "STNO_OO";
        };

        stno_ble: stno_ble {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp L &kp E>;
            label = "STNO_BLE";
        };

        stno_ua: stno_ua {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
