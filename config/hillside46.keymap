        };

        stno_fl: stno_fl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &kp L>;
            label = "STNO_FL";
        };

        stno_lf: stno_lf {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp F>;
            label = "STNO_LF";
        };

        stno_gt: stno_gt {
            compatible = "zmk,behavior-macro";
