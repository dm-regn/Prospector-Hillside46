        trpl_mclk: trpl_mclk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp LCLK &mkp LCLK &mkp LCLK>;
            label = "TRPL_MCLK";
        };

        stno_gh: stno_gh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
