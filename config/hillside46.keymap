        fast_1st: fast_1st {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp E &kp L &kp L &kp O &kp N>;
            label = "FAST_1ST";
        };

        fast_id: fast_id {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N5 &kp N6 &kp N4 &kp N1 &kp N5 &kp LS(D) &kp LS(M)>;
            label = "FAST_ID";
        };

        apos_c: apos_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp SQT>;
            label = "APOS_C";
        };

        fast_na: fast_na {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
